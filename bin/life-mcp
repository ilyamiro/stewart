#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SCRIPT_DIR/mcp:$SCRIPT_DIR:$PYTHONPATH"
if python3 -c "import pydantic" >/dev/null 2>&1; then
    exec python3 -m life.mcp_server "$@"
else
    exec nix-shell "/home/ilyamiro/Projects/life/shell.nix" --run "python3 -m life.mcp_server" "$@"
fi
